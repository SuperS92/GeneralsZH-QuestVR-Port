+#pragma once
+#include <cstdint>
+namespace dxvk {
+// GeneralsX @feature Codex 17/10/2026 0 skip, 1 solid, 2 alpha-over, 3 unsupported.
+inline uint32_t QuestCoveragePolicy(uint32_t blend,uint32_t src,uint32_t dst,uint32_t op,uint32_t mask) {
+  if(!(mask&7))return 0;
+  if((mask&7)!=7)return 3;
+  if(!blend)return 1;
+  if(op!=1)return 3;
+  if((src==2||src==5)&&dst==1)return 1;
+  if((src==2||src==5)&&dst==6)return 2;
+  if((src==1&&dst==2)||((src==2||src==5)&&dst==2)||(src==1&&dst==3)||(src==9&&dst==1))return 0;
+  if(src==7&&(dst==8||dst==2))return 1;
+  return 3;
+}
+}
