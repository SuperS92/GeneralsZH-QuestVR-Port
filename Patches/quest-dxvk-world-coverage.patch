+  HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::BeginWorldCoverage(ID3D9VkInteropTexture* eye, ID3D9VkInteropTexture* mask) {
+    D3D9DeviceLock lock=m_device->LockDevice();
+    if(!eye||!mask||m_device->m_questCoverageView||!m_device->m_flags.test(D3D9DeviceFlag::InScene)
+        ||m_device->m_state.renderTargets[0]==nullptr||m_device->m_state.renderTargets[3]!=nullptr)return D3DERR_INVALIDCALL;
+    auto e=static_cast<D3D9VkInteropTexture*>(eye)->GetCommonTexture();
+    auto m=static_cast<D3D9VkInteropTexture*>(mask)->GetCommonTexture();
+    if(e!=m_device->m_state.renderTargets[0]->GetCommonTexture()||e==m
+        ||m->Desc()->Format!=D3D9Format::A8R8G8B8||m->Desc()->Width!=e->Desc()->Width||m->Desc()->Height!=e->Desc()->Height
+        ||m->Desc()->MultiSample!=D3DMULTISAMPLE_NONE||e->Desc()->MultiSample!=D3DMULTISAMPLE_NONE
+        ||m->Desc()->MipLevels!=1||m->Desc()->ArraySize!=1||!(m->Desc()->Usage&D3DUSAGE_RENDERTARGET))return D3DERR_INVALIDCALL;
+    m_device->m_questCoverageEye=e->GetImage();
+    m_device->m_questCoverageView=m->CreateView(0,0,VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,false);
+    m_device->m_questCoverageFailed=false;
+    m_device->m_flags.set(D3D9DeviceFlag::DirtyFramebuffer,D3D9DeviceFlag::DirtyBlendState);
+    return m_device->m_questCoverageView?D3D_OK:D3DERR_INVALIDCALL;
+  }
+  HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::EndWorldCoverage() {
+    D3D9DeviceLock lock=m_device->LockDevice();
+    const bool ok=m_device->m_questCoverageView&&!m_device->m_questCoverageFailed;
+    m_device->m_questCoverageView=nullptr;m_device->m_questCoverageEye=nullptr;m_device->m_questCoverageMode=0;
+    m_device->m_flags.set(D3D9DeviceFlag::DirtyFramebuffer,D3D9DeviceFlag::DirtyBlendState);
+    if(m_device->m_specInfo.set<SpecQuestCoverage>(0))m_device->m_flags.set(D3D9DeviceFlag::DirtySpecializationEntries);
+    return ok?D3D_OK:D3DERR_INVALIDCALL;
+  }
