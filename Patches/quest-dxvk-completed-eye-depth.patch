+  // GeneralsX @performance Codex 14/10/2026 Explicit completed-eye lifetime only.
+  HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::DiscardCompletedEyeDepth(
+          ID3D9VkInteropTexture* pTexture) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+    if (!pTexture || !m_device->m_flags.test(D3D9DeviceFlag::InScene)
+        || m_device->m_state.depthStencil == nullptr)
+      return D3DERR_INVALIDCALL;
+    auto texture = static_cast<D3D9VkInteropTexture*>(pTexture)->GetCommonTexture();
+    if (texture != m_device->m_state.depthStencil->GetCommonTexture()
+        || texture->Desc()->Format != D3D9Format::D24S8
+        || texture->Desc()->MultiSample != D3DMULTISAMPLE_NONE
+        || texture->Desc()->MipLevels != 1 || texture->Desc()->ArraySize != 1
+        || !(texture->Desc()->Usage & D3DUSAGE_DEPTHSTENCIL))
+      return D3DERR_INVALIDCALL;
+    auto view = m_device->m_state.depthStencil->GetDepthStencilView();
+    if (view == nullptr) return D3DERR_INVALIDCALL;
+    m_device->EmitCs([cView = std::move(view)](DxvkContext* ctx) {
+      ctx->discardImageView(cView, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+    });
+    // Queued on the original command stream, not proof of a retroactive store-op change.
+    return D3D_OK;
+  }
+#endif
 
