--- a/portfile.cmake
+++ b/portfile.cmake
@@ -163,6 +163,9 @@
     find_program(SHELL bash)
 endif()
 
+if(VCPKG_HOST_IS_WINDOWS)
+    list(PREPEND prog_env "${CMAKE_CURRENT_LIST_DIR}/../bin")
+endif()
 list(REMOVE_DUPLICATES prog_env)
 vcpkg_add_to_path(PREPEND ${prog_env})
 
@@ -774,6 +777,14 @@
     set(BUILD_DIR         "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel")
     set(CONFIGURE_OPTIONS "${OPTIONS} ${OPTIONS_RELEASE}")
     set(INST_PREFIX       "${CURRENT_PACKAGES_DIR}")
+    # Local Windows host workaround: MSYS installation tools need a POSIX path.
+    # Only the staging prefix changes; sources/options/compiler profile do not.
+    if(CMAKE_HOST_WIN32 AND INST_PREFIX MATCHES "^[A-Za-z]:/")
+        string(SUBSTRING "${INST_PREFIX}" 0 1 _quest_drive)
+        string(TOLOWER "${_quest_drive}" _quest_drive)
+        string(SUBSTRING "${INST_PREFIX}" 2 -1 _quest_path)
+        set(INST_PREFIX "/${_quest_drive}${_quest_path}")
+    endif()
 
     configure_file("${CMAKE_CURRENT_LIST_DIR}/build.sh.in" "${BUILD_DIR}/build.sh" @ONLY)
 
@@ -815,6 +826,14 @@
     set(BUILD_DIR         "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg")
     set(CONFIGURE_OPTIONS "${OPTIONS} ${OPTIONS_DEBUG}")
     set(INST_PREFIX       "${CURRENT_PACKAGES_DIR}/debug")
+    # Local Windows host workaround: MSYS installation tools need a POSIX path.
+    # Only the staging prefix changes; sources/options/compiler profile do not.
+    if(CMAKE_HOST_WIN32 AND INST_PREFIX MATCHES "^[A-Za-z]:/")
+        string(SUBSTRING "${INST_PREFIX}" 0 1 _quest_drive)
+        string(TOLOWER "${_quest_drive}" _quest_drive)
+        string(SUBSTRING "${INST_PREFIX}" 2 -1 _quest_path)
+        set(INST_PREFIX "/${_quest_drive}${_quest_path}")
+    endif()
 
     configure_file("${CMAKE_CURRENT_LIST_DIR}/build.sh.in" "${BUILD_DIR}/build.sh" @ONLY)
 
@@ -906,6 +925,16 @@
             endif()
         endforeach()
         file(WRITE "${file}" "${content}")
+    endforeach()
+endif()
+# Normalize MSYS staging paths before vcpkg relocates pkg-config metadata.
+if(CMAKE_HOST_WIN32)
+    file(GLOB _quest_pc "${CURRENT_PACKAGES_DIR}/lib/pkgconfig/*.pc" "${CURRENT_PACKAGES_DIR}/debug/lib/pkgconfig/*.pc")
+    foreach(_quest_file IN LISTS _quest_pc)
+        file(READ "${_quest_file}" _quest_content)
+        string(REGEX REPLACE "libdir=[^\n]*" "libdir=\${prefix}/lib" _quest_content "${_quest_content}")
+        string(REGEX REPLACE "includedir=[^\n]*" "includedir=\${prefix}/include" _quest_content "${_quest_content}")
+        file(WRITE "${_quest_file}" "${_quest_content}")
     endforeach()
 endif()
 vcpkg_fixup_pkgconfig()
